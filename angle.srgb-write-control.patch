+TEST_P(SRGBFramebufferTest, ClearAndBlendWithWriteControl)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_sRGB_write_control"));
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_sRGB") && getClientMajorVersion() < 3);
+
+    GLTexture texture;
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_SRGB_ALPHA_EXT, 4, 4, 0, GL_SRGB_ALPHA_EXT, GL_UNSIGNED_BYTE,
+                 nullptr);
+    GLFramebuffer framebuffer;
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, texture, 0);
+    ASSERT_GL_FRAMEBUFFER_COMPLETE(GL_FRAMEBUFFER);
+    glViewport(0, 0, 4, 4);
+
+    glUseProgram(mProgram);
+    glUniform4f(mColorLocation, 0.25f, 0.25f, 0.25f, 0.25f);
+    glBlendFunc(GL_ONE, GL_ONE);
+
+    for (bool srgbEnabled : {false, true})
+    {
+        if (srgbEnabled)
+        {
+            glEnable(GL_FRAMEBUFFER_SRGB_EXT);
+        }
+        else
+        {
+            glDisable(GL_FRAMEBUFFER_SRGB_EXT);
+        }
+
+        glClearColor(0.25f, 0.25f, 0.25f, 0.25f);
+        glClear(GL_COLOR_BUFFER_BIT);
+        EXPECT_PIXEL_NEAR(3, 0, srgbEnabled ? 137 : 64, srgbEnabled ? 137 : 64,
+                          srgbEnabled ? 137 : 64, 64, 1);
+
+        glEnable(GL_SCISSOR_TEST);
+        glScissor(0, 0, 2, 4);
+        glClearColor(0.5f, 0.5f, 0.5f, 0.5f);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glDisable(GL_SCISSOR_TEST);
+
+        glEnable(GL_BLEND);
+        drawQuad(mProgram, essl1_shaders::PositionAttrib(), 0.0f);
+        glDisable(GL_BLEND);
+        ASSERT_GL_NO_ERROR();
+
+        EXPECT_PIXEL_NEAR(0, 0, srgbEnabled ? 225 : 191, srgbEnabled ? 225 : 191,
+                          srgbEnabled ? 225 : 191, 191, 2);
+        EXPECT_PIXEL_NEAR(3, 0, srgbEnabled ? 188 : 128, srgbEnabled ? 188 : 128,
+                          srgbEnabled ? 188 : 128, 128, 2);
+    }
+}
