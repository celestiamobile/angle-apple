+TEST_P(SRGBFramebufferTestES3, MixedColorAttachmentsWriteControl)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_sRGB_write_control"));
+
+    GLTexture linearTexture;
+    glBindTexture(GL_TEXTURE_2D, linearTexture);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, 4, 4);
+    GLTexture srgbTexture;
+    glBindTexture(GL_TEXTURE_2D, srgbTexture);
+    glTexStorage2D(GL_TEXTURE_2D, 1, GL_SRGB8_ALPHA8, 4, 4);
+    GLFramebuffer framebuffer;
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, linearTexture, 0);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, srgbTexture, 0);
+    constexpr GLenum kDrawBuffers[] = {GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1};
+    glDrawBuffers(2, kDrawBuffers);
+    ASSERT_GL_FRAMEBUFFER_COMPLETE(GL_FRAMEBUFFER);
+    glViewport(0, 0, 4, 4);
+
+    constexpr char kFragmentShader[] = R"(#version 300 es
+precision highp float;
+uniform vec4 color;
+layout(location = 0) out vec4 linearOutput;
+layout(location = 1) out vec4 srgbOutput;
+void main()
+{
+    linearOutput = color;
+    srgbOutput = color;
+})";
+    ANGLE_GL_PROGRAM(program, essl3_shaders::vs::Simple(), kFragmentShader);
+    glUseProgram(program);
+    glUniform4fv(glGetUniformLocation(program, "color"), 1, srgbColor.toNormalizedVector().data());
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(0, 0, 2, 4);
+    glEnable(GL_FRAMEBUFFER_SRGB_EXT);
+    drawQuad(program, essl3_shaders::PositionAttrib(), 0.0f);
+    glScissor(2, 0, 2, 4);
+    glDisable(GL_FRAMEBUFFER_SRGB_EXT);
+    drawQuad(program, essl3_shaders::PositionAttrib(), 0.0f);
+    ASSERT_GL_NO_ERROR();
+
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    EXPECT_PIXEL_COLOR_NEAR(0, 0, srgbColor, 1);
+    EXPECT_PIXEL_COLOR_NEAR(3, 0, srgbColor, 1);
+    glReadBuffer(GL_COLOR_ATTACHMENT1);
+    EXPECT_PIXEL_COLOR_NEAR(0, 0, linearColor, 1);
+    EXPECT_PIXEL_COLOR_NEAR(3, 0, srgbColor, 1);
+}
