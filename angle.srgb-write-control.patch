+    if (get().storageMode == MTLStorageModeMemoryless)
+    {
+        // Memoryless textures cannot have views. Their contents are restored from the resolve
+        // texture at each render pass, so a separate transient attachment is sufficient.
+        ASSERT(mCreationDesc);
+        angle::ObjCPtr<MTLTextureDescriptor> desc = angle::adoptObjCPtr([mCreationDesc.get() copy]);
+        desc.get().pixelFormat                    = linearFormat;
+        auto texture     = angle::adoptObjCPtr([get().device newTextureWithDescriptor:desc.get()]);
+        mLinearColorView = MakeFromMetal(texture.get());
+        mLinearColorView->mShouldNotLoadStore = mShouldNotLoadStore;
+        mLinearColorView->mColorWritableMask  = mColorWritableMask;
+    }
+    else
+    {
+        mLinearColorView = createViewWithCompatibleFormat(linearFormat);
     }
 
     return mLinearColorView;
