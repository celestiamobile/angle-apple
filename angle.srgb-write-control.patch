+TEST_P(SRGBFramebufferDefaultSrgbTest, ToggleWriteControl)
+{
+    ANGLE_SKIP_TEST_IF(!IsGLExtensionEnabled("GL_EXT_sRGB_write_control"));
+
+    ANGLE_GL_PROGRAM(program, essl1_shaders::vs::Simple(), essl1_shaders::fs::UniformColor());
+    glUseProgram(program);
+    glUniform4fv(glGetUniformLocation(program, essl1_shaders::ColorUniform()), 1,
+                 srgbColor.toNormalizedVector().data());
+    glClearColor(0.25f, 0.25f, 0.25f, 0.5f);
+
+    for (bool srgbEnabled : {false, true})
+    {
+        if (srgbEnabled)
+        {
+            glEnable(GL_FRAMEBUFFER_SRGB_EXT);
+        }
+        else
+        {
+            glDisable(GL_FRAMEBUFFER_SRGB_EXT);
+        }
+        glClear(GL_COLOR_BUFFER_BIT);
+        EXPECT_PIXEL_NEAR(0, 0, srgbEnabled ? 137 : 64, srgbEnabled ? 137 : 64,
+                          srgbEnabled ? 137 : 64, 128, 1);
+        drawQuad(program, essl1_shaders::PositionAttrib(), 0.0f);
+        ASSERT_GL_NO_ERROR();
+        const GLColor expectedColor = srgbEnabled ? linearColor : srgbColor;
+        EXPECT_PIXEL_COLOR_NEAR(0, 0, expectedColor, 1);
+        swapBuffers();
+    }
+}
