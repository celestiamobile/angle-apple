+
+#include "test_utils/ANGLETest.h"
+
+#include "libANGLE/Context.h"
+#include "libANGLE/Display.h"
+#include "libANGLE/renderer/metal/ContextMtl.h"
+#include "libANGLE/renderer/metal/DisplayMtl.h"
+#include "libANGLE/renderer/metal/mtl_resources.h"
+
+using namespace angle;
+
+namespace
+{
+class TextureTestMetal : public ANGLETest<>
+{
+  protected:
+    TextureTestMetal()
+    {
+        setWindowWidth(16);
+        setWindowHeight(16);
+    }
+
+    rx::ContextMtl *getContextMtl()
+    {
+        egl::Display *display   = static_cast<egl::Display *>(getEGLWindow()->getDisplay());
+        gl::ContextID contextID = {
+            static_cast<GLuint>(reinterpret_cast<uintptr_t>(getEGLWindow()->getContext()))};
+        return rx::mtl::GetImpl(display->getContext(contextID));
+    }
+};
+
+TEST_P(TextureTestMetal, ShaderWriteUsage)
+{
+    rx::ContextMtl *context = getContextMtl();
+    const auto &format      = context->getPixelFormat(angle::FormatID::R16G16B16A16_FLOAT);
+    ASSERT_TRUE(context->getNativeFormatCaps(format.metalFormat).writable);
+    const bool needsImageWrites =
+        context->getDisplay()->getMaxSupportedESVersion() >= gl::Version(3, 1) ||
+        context->getNativePixelLocalStorageOptions().type ==
+            ShPixelLocalStorageType::ImageLoadStore;
+
+    rx::mtl::TextureRef singleLevel;
+    ASSERT_EQ(
+        rx::mtl::Texture::Make2DTexture(context, format, 16, 16, 1, false, true, &singleLevel),
+        angle::Result::Continue);
+    EXPECT_TRUE(singleLevel->isShaderReadable());
+    EXPECT_EQ(singleLevel->isShaderWritable(), needsImageWrites);
+    EXPECT_NE(singleLevel->get().usage & MTLTextureUsageRenderTarget, 0u);
+    EXPECT_TRUE(singleLevel->supportFormatView());
+
+    rx::mtl::TextureRef mipmapped;
+    ASSERT_EQ(rx::mtl::Texture::Make2DTexture(context, format, 16, 16, 2, false, true, &mipmapped),
+              angle::Result::Continue);
+    EXPECT_TRUE(mipmapped->isShaderWritable());
+
+    rx::mtl::TextureRef volume;
+    ASSERT_EQ(rx::mtl::Texture::Make3DTexture(context, format, 16, 16, 4, 1, false, true, &volume),
+              angle::Result::Continue);
+    EXPECT_TRUE(volume->isShaderWritable());
+}
+
+ANGLE_INSTANTIATE_TEST(TextureTestMetal,
+                       ES3_METAL(),
+                       ES3_METAL().enable(Feature::DisableProgrammableBlending));
+}  // namespace
