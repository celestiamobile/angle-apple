Conservative Metal texture usage optimization for chromium/8127.
Apply after the preceding patches in build.sh.

Avoid ShaderWrite for single-level 2D textures when neither GLES image access
nor image-load/store pixel local storage requires it. Preserve render-target
and sampling usage, and retain shader writes for other types and mip chains.
IOSurface-backed textures are unchanged.

diff --git a/src/libANGLE/renderer/metal/mtl_resources.mm b/src/libANGLE/renderer/metal/mtl_resources.mm
--- a/src/libANGLE/renderer/metal/mtl_resources.mm
+++ b/src/libANGLE/renderer/metal/mtl_resources.mm
@@ -456,7 +456,14 @@ Texture::Texture(ContextMtl *context,
         if (!renderTargetOnly || needMultisampleColorFormatShaderReadWorkaround(context, desc))
         {
             desc.usage = desc.usage | MTLTextureUsageShaderRead;
-            if (context->getNativeFormatCaps(desc.pixelFormat).writable)
+            // Single-level 2D textures need no compute mip writes. Keep image-access paths
+            // writable, but avoid restricting Metal's layout choices for sampling/rendering.
+            const bool needsShaderWrite =
+                desc.textureType != MTLTextureType2D || desc.mipmapLevelCount > 1 ||
+                context->getDisplay()->getMaxSupportedESVersion() >= gl::Version(3, 1) ||
+                context->getNativePixelLocalStorageOptions().type ==
+                    ShPixelLocalStorageType::ImageLoadStore;
+            if (context->getNativeFormatCaps(desc.pixelFormat).writable && needsShaderWrite)
             {
                 desc.usage = desc.usage | MTLTextureUsageShaderWrite;
             }
